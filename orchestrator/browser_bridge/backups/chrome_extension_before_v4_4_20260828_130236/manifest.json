{
  "manifest_version": 3,
  "name": "PROJECT-1 Browser Chat Bridge",
  "version": "4.0.0",
  "description": "Browser bridge for PROJECT-1 orchestrator.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PROJECT-1 Browser Bridge",
    "default_popup": "popup.html"
  }
}